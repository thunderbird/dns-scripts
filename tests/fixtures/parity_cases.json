{
  "_comment": "Shared fixtures exercised by BOTH the Python suite (tests/test_parity.py) and the Node harness (tests/parity/run_js.mjs). JSON has no comment syntax, so this key documents intent. matchCases feed check_answers()/checkAnswers() plus the failure wording (verdict is the status: ok / missing / conflict); resolveCases feed resolve_record/resolveRecord + value_of/valueOf.",
  "matchCases": [
    {"name": "exact rejects appended target (#10)", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com.example.com"], "mode": "exact", "verdict": "missing"},
    {"name": "exact accepts correct target", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com"], "mode": "exact", "verdict": "ok"},
    {"name": "exact accepts among multiple answers", "expected": "10 mail.thundermail.com", "answers": ["20 backup.example.com", "10 mail.thundermail.com"], "mode": "exact", "verdict": "ok"},
    {"name": "exact is case-insensitive", "expected": "tm1.example.com.dkim.thunderhosted.com", "answers": ["TM1.EXAMPLE.COM.DKIM.THUNDERHOSTED.COM"], "mode": "exact", "verdict": "ok"},
    {"name": "exact rejects empty answers", "expected": "10 mail.thundermail.com", "answers": [], "mode": "exact", "verdict": "missing"},
    {"name": "contains accepts prefix fragment", "expected": "v=STSv1;", "answers": ["v=STSv1; id=18139500144460329770"], "mode": "contains", "verdict": "ok"},
    {"name": "contains rejects absent fragment", "expected": "v=STSv1;", "answers": ["v=spf1 include:spf.thundermail.com -all"], "mode": "contains", "verdict": "missing"},
    {"name": "contains matches full SPF value", "expected": "v=spf1 include:spf.thundermail.com -all", "answers": ["v=spf1 include:spf.thundermail.com -all"], "mode": "contains", "verdict": "ok"},
    {"name": "srv accepts any weight (Plesk dropdown, #14)", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 5 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv accepts the exact record", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv still rejects appended target (#10)", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com.example.com"], "mode": "srv_lowest_priority", "verdict": "missing"},
    {"name": "srv accepts a higher priority number when alone (accounts#1163)", "expected": "0 0 443 mail.thundermail.com", "answers": ["10 1 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv rejects wrong port", "expected": "0 0 993 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "missing"},
    {"name": "srv rejects malformed answer", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 443 mail.thundermail.com", ""], "mode": "srv_lowest_priority", "verdict": "missing"},
    {"name": "srv rejects a non-numeric priority", "expected": "0 0 443 mail.thundermail.com", "answers": ["x 0 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "missing"},
    {"name": "srv rejects empty answers", "expected": "0 0 443 mail.thundermail.com", "answers": [], "mode": "srv_lowest_priority", "verdict": "missing"},
    {"name": "srv is case-insensitive", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 5 443 MAIL.THUNDERMAIL.COM"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv conflict: another target ties our priority (accounts#1163 screenshot)", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com", "0 0 443 mail.example.net"], "mode": "srv_lowest_priority", "verdict": "conflict"},
    {"name": "srv conflict: another target out-ranks us", "expected": "0 0 443 mail.thundermail.com", "answers": ["10 0 443 mail.thundermail.com", "5 0 443 mail.example.net"], "mode": "srv_lowest_priority", "verdict": "conflict"},
    {"name": "srv conflict: another port at the same priority", "expected": "0 0 993 mail.thundermail.com", "answers": ["0 0 993 mail.thundermail.com", "0 0 143 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "conflict"},
    {"name": "srv ok: we out-rank the other target", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com", "10 0 443 mail.example.net"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv ok: duplicate copies of our own record are not a conflict", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com", "0 5 443 mail.thundermail.com"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv ok: an unrankable answer alongside ours is ignored", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com", "garbage"], "mode": "srv_lowest_priority", "verdict": "ok"},
    {"name": "srv ok: our lowest copy wins even if a higher copy is out-ranked", "expected": "0 0 443 mail.thundermail.com", "answers": ["0 0 443 mail.thundermail.com", "20 0 443 mail.thundermail.com", "10 0 443 mail.example.net"], "mode": "srv_lowest_priority", "verdict": "ok"}
  ],
  "resolveCases": [
    {"name": "MX apex", "domain": "example.com", "record": {"type": "MX", "host": "@", "priority": 10, "target": "mail.thundermail.com"}},
    {"name": "SRV apex", "domain": "example.com", "record": {"type": "SRV", "host": "_jmap._tcp", "priority": 0, "weight": 0, "port": 443, "target": "mail.thundermail.com"}},
    {"name": "TXT apex SPF", "domain": "example.com", "record": {"type": "TXT", "host": "@", "label": "@ (SPF)", "value": "v=spf1 include:spf.thundermail.com -all", "match": "v=spf1 include:spf.thundermail.com -all"}},
    {"name": "TXT TLSRPT with {domain} token", "domain": "example.com", "record": {"type": "TXT", "host": "_smtp._tls", "value": "v=TLSRPTv1; rua=mailto:postmaster@{domain}", "match": "v=TLSRPTv1;"}},
    {"name": "CNAME DKIM subdomain with {domain} token", "domain": "example.com", "record": {"type": "CNAME", "host": "tm1._domainkey", "target": "tm1.{domain}.dkim.thunderhosted.com"}},
    {"name": "SRV non-apex (exercises srvhost/srvsubhost rest label)", "domain": "example.com", "record": {"type": "SRV", "host": "_sip._tcp.pbx", "priority": 5, "weight": 10, "port": 5060, "target": "sip.example.net"}}
  ]
}
